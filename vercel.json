{
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=lessons"
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=freq"
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=science"
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=lessons"
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=freq"
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "dest": "/api/legacy-page?to=science"
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "song" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "song" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "view" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "view" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
