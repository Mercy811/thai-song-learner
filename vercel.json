{
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/lessons",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/freq",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/science",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/lessons",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/freq",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "destination": "/science",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "song" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "song" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "view" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "view" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
