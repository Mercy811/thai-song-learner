{
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/lessons" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/freq" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/science" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "lessons" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/lessons" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "freq" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/freq" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "query", "key": "page", "value": "science" }],
      "missing": [{ "type": "query", "key": "song" }],
      "status": 301,
      "headers": { "Location": "/science" },
      "transforms": [{ "type": "request.query", "op": "delete", "target": { "key": "page" } }]
    },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "song" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "song" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "view" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "view" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
